<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Allison's Portfolio | Thank You</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/styles/style.css">
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">

            <a class="navbar-brand" href="/">
                Allison's Portfolio
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
                aria-controls="navbarNav"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/about">
                            About
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contact">
                            Contact
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container my-5">

        <section class="row justify-content-center">

            <div class="col-md-8 col-lg-7">

                <div class="card shadow-sm border-success">

                    <div class="card-header bg-success text-white text-center">
                        <h1 class="h3 mb-0">
                            Thank You!
                        </h1>
                    </div>

                    <div class="card-body p-4">

                        <div class="alert alert-success text-center">
                            Your contact form was submitted successfully!
                        </div>

                        <h2 class="h4 mb-4">
                            Here's the Information You Submitted:
                        </h2>

                        <!-- Submitted Name -->
                        <div class="mb-3">
                            <h3 class="h6 fw-bold">
                                Name:
                            </h3>

                            <p class="form-control bg-light">
                                <%= name %>
                            </p>
                        </div>

                        <!-- Submitted Email -->
                        <div class="mb-3">
                            <h3 class="h6 fw-bold">
                                Email Address:
                            </h3>

                            <p class="form-control bg-light">
                                <%= email %>
                            </p>
                        </div>

                        <!-- Submitted Message -->
                        <div class="mb-4">
                            <h3 class="h6 fw-bold">
                                Message:
                            </h3>

                            <p class="form-control bg-light"
                               style="white-space: pre-wrap;"><%= message %></p>
                        </div>

                        <!-- Navigation Buttons -->
                        <div class="d-flex flex-wrap gap-3 justify-content-center">

                            <a href="/contact" class="btn btn-primary">
                                Send Another Message
                            </a>

                            <a href="/" class="btn btn-outline-primary">
                                Return to Home
                            </a>

                        </div>

                    </div>
                </div>

            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3">

        <p class="mb-0">
            &copy; 2026 Allison's Portfolio |
            CIS 515 - Web Development
        </p>

    </footer>

    <!-- Bootstrap JavaScript -->
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>