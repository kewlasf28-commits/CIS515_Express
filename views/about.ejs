<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Allison's Portfolio | About Me</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/styles/style.css">
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">

            <a class="navbar-brand" href="/">
                Allison's Portfolio
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
                aria-controls="navbarNav"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a
                            class="nav-link active"
                            aria-current="page"
                            href="/about"
                        >
                            About
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contact">
                            Contact
                        </a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>

    <!-- Main Content -->
    <main class="container my-5">

        <!-- About Me Heading -->
        <section class="text-center mb-5">

            <h1>About Me</h1>

            <p class="lead">
                Welcome! I'm a student at Des Moines Area
                Community College studying web development
                and programming.
            </p>

        </section>

        <!-- Web Development Journey -->
        <section class="row mb-5">

            <div class="col-md-8 mx-auto">

                <h2>My Web Development Journey</h2>

                <p>
                    I created this website as part of my CIS 515
                    coursework at Des Moines Area Community College.
                    It demonstrates the web development skills
                    I have been learning throughout the semester.
                </p>

                <p>
                    I started by creating HTML pages and adding
                    CSS to customize the appearance of my website.
                    As the course progressed, I learned how to
                    use Bootstrap to create responsive layouts,
                    navigation menus, and reusable components.
                </p>

                <p>
                    Now I am expanding my website by using
                    Node.js and Express.js to add server-side
                    functionality. This allows my website to
                    receive and process information from visitors
                    through a contact form.
                </p>

                <p>
                    My goal is to continue improving my programming
                    skills while creating websites that are
                    organized, accessible, and easy to navigate.
                    Each project gives me an opportunity to
                    practice new techniques and solve problems.
                </p>

            </div>

        </section>

        <!-- Skills Section -->
        <section class="row mb-5">

            <div class="col-md-8 mx-auto">

                <h2>Skills I'm Learning</h2>

                <ul class="list-group">

                    <li class="list-group-item">
                        HTML5 and semantic webpage structure
                    </li>

                    <li class="list-group-item">
                        CSS3 and responsive web design
                    </li>

                    <li class="list-group-item">
                        Bootstrap layouts and components
                    </li>

                    <li class="list-group-item">
                        JavaScript programming
                    </li>

                    <li class="list-group-item">
                        Node.js and Express.js
                    </li>

                    <li class="list-group-item">
                        Git and GitHub version control
                    </li>

                </ul>

            </div>

        </section>

        <!-- Contact Section -->
        <section class="text-center bg-light p-5 rounded">

            <h2>Let's Connect!</h2>

            <p>
                Want to learn more about my projects
                or get in touch?
                Visit my contact page.
            </p>

            <a href="/contact" class="btn btn-primary btn-lg">
                Contact Me
            </a>

        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3">

        <p class="mb-0">
            &copy; 2026 Allison's Portfolio |
            CIS 515 - Web Development
        </p>

    </footer>

    <!-- Bootstrap JavaScript -->
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>