<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Allison's Portfolio | Home</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/styles/style.css">
</head>

<body>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/">Allison's Portfolio</a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
                aria-controls="navbarNav"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link active
                        aria-current="page " href="/about">About</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contact">Contact</a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container my-5">

        <div class="text-center mb-5">
            <h1>Welcome to My Portfolio</h1>

            <p class="lead">
                This website showcases my projects,
                technical skills, and progress as a
                student at Des Moines Area Community College.
            </p>
        </div>

        <!-- About Section -->
        <section class="row mb-5">
            <div class="col-md-8 mx-auto">

                <h2>My Web Development Journey</h2>

                <p>
                    I created this website as part of my CIS 515
                    coursework at Des Moines Area Community College.
                    It demonstrates the web development skills
                    I have been learning throughout the semester.
                </p>

                <p>
                    I started by creating HTML pages and adding
                    CSS to customize the appearance of my website.
                    As the course progressed, I learned how to
                    use Bootstrap to create responsive layouts,
                    navigation menus, and reusable components.
                </p>

                <p>
                    Now I am expanding my website by using
                    Node.js and Express.js to add server-side
                    functionality. This allows my website to
                    receive and process information from visitors
                    through a contact form.
                </p>

                <p>
                    My goal is to continue improving my programming
                    skills while creating websites that are
                    organized, accessible, and easy to navigate.
                    Each project gives me an opportunity to
                    practice new techniques and solve problems.
                </p>

            </div>
        </section>

        <!-- Project Cards -->
        <section class="mb-5">

            <h2 class="text-center mb-4">My Projects</h2>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">

                            <h3 class="card-title h5">
                                Foundational Website
                            </h3>

                            <p class="card-text">
                                My foundational website demonstrates
                                HTML, CSS, Bootstrap, responsive design,
                                and website navigation.
                            </p>

                            <a href="/about"
                               class="btn btn-primary">
                                Learn More
                            </a>

                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">

                            <h3 class="card-title h5">
                                Hire Me Dashboard
                            </h3>

                            <p class="card-text">
                                My Hire Me Dashboard helps organize
                                job applications and track progress
                                through different application stages.
                            </p>

                            <a href="/contact"
                               class="btn btn-success">
                                Contact Me
                            </a>

                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- Contact Section -->
        <section class="text-center bg-light p-5 rounded">

            <h2>Get in Touch!</h2>

            <p>
                Have a question or want to learn more
                about my projects?
                Visit my contact page.
            </p>

            <a href="/contact" class="btn btn-primary btn-lg">
                Contact Me
            </a>

        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3">
        <p class="mb-0">
            &copy; 2026 Allison's Portfolio |
            CIS 515 - Web Development
        </p>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>
app.get('/about', (req, res) => {
    res.render('about');
});